# 生产环境变量
# 在生产构建时使用 (npm run build)

# API 基础 URL - 生产环境（走 nginx 80 端口 /api/v1 反代到 backend，与 Web 端同链路；勿写 service.fastapiadmin.com 模板域名）
VITE_API_BASE_URL=http://106.55.33.111

# 环境名称
VITE_ENV_NAME=production

# 项目名称
VITE_APP_TITLE=智慧胸痛管理

# 代理前缀
VITE_APP_BASE_API=/api/v1

# 应用端口
VITE_APP_PORT=5180

# 超时时间
VITE_TIMEOUT=10000

# WebSocket 服务器的 URL（AI 对话用）：填公网 IP；留空会自动从 VITE_API_BASE_URL 推导 http→ws（效果等同）
VITE_APP_WS_ENDPOINT= ws://106.55.33.111
